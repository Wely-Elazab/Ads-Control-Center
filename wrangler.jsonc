// Ads Center على Cloudflare Workers — الموقع والـ API من نفس المكان.
// Cloudflare بيبني وينشر تلقائياً مع كل push على main (Workers Builds: Root directory = /).
// الاسم لازم يفضل زي اسم الـ Worker في لوحة Cloudflare، وإلا البناء بيفشل.
{
  "name": "ads-center",
  "main": "Live/cloudflare/worker.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    // الصفحات الثابتة. الملفات اللي مبتتنشرش في Live/.assetsignore
    "directory": "./Live",
    "binding": "ASSETS",
    // الـ Worker بيشتغل على كل طلب عشان يطبّق الـ rewrites ورؤوس الأمان
    "run_worker_first": true,
    // الملفات بأسمائها بالظبط (/help.html)، والروابط النظيفة (/help و/app) من الـ rewrites في الـ Worker
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // سجلات التشغيل للمتابعة لو حصل خطأ — الكود مبيكتبش أي بيانات عملاء في السجلات
  "observability": { "enabled": true },
  // نبض يومي لمشروع Supabase (scheduled في worker.js) — ٩:٤١ UTC، بعيد عن نبض pg_cron (٤:٢٣)
  "triggers": { "crons": ["41 9 * * *"] },
  // الأسرار (GOOGLE_CLIENT_ID وGOOGLE_CLIENT_SECRET وGOOGLE_ADS_DEVELOPER_TOKEN وSNAPCHAT_CLIENT_ID وSNAPCHAT_CLIENT_SECRET)
  // — GOOGLE_CLIENT_SECRET بيشغّل الدخول بمفتاح تجديد لـ Google (api/google-token.js)، ومن غيره النافذة القديمة
  // بتتحط من لوحة Cloudflare كـ Secret ومبتتمسحش مع النشر. keep_vars بيحمي كمان أي متغيّر نصي
  // اتحط من اللوحة بالغلط كـ Text بدل Secret — من غيره كل نشر كان هيمسحه
  "keep_vars": true,
  // الدومين الرسمي (مدار من Cloudflare). www بيتحوّل للأساسي من جوه الـ Worker.
  // Cloudflare بيعمل سجلات DNS وشهادة HTTPS لوحده مع النشر
  "routes": [
    { "pattern": "adscenter.online", "custom_domain": true },
    { "pattern": "www.adscenter.online", "custom_domain": true }
  ],
  // الموقع على adscenter.online بس — رابط workers.dev القديم وروابط المعاينة مقفولين
  "workers_dev": false,
  "preview_urls": false
}
